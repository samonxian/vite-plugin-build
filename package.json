{
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "commitizen": "^4.2.5",
    "eslint": "^8.57.1",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^17.24.0",
    "git-cz": "^4.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  },
  "scripts": {
    "prepare": "husky",
    "cm": "git-cz",
    "lint-staged": "lint-staged --allow-empty",
    "commitlint": "commitlint --edit $1",
    "build": "pnpm --filter run-in-task-pool build && pnpm --filter svelte-tsc build && pnpm --filter vite-plugin-build build",
    "build:publish": "pnpm run build && pnpm -r --filter './packages/*' publish --access public"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
